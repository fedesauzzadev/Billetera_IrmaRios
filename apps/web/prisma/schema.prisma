// Ledger + Outbox + Idempotencia. Todo lo financiero vive aca (PostgreSQL).
// LEARN: balance es snapshot (no SUM en caliente). version = OCC. outbox = eventos sin dual-write.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  alias     String   @unique
  currency  String   @default("ARS")
  // Montos como String decimal exacto, nunca float. Ej: "1500.00"
  balance   String   @default("0.00")
  status    String   @default("ACTIVE")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounts")
}

model Transfer {
  id             String   @id @default(uuid())
  sourceAccount  String   @map("source_account")
  destAccount    String   @map("dest_account")
  amount         String
  currency       String   @default("ARS")
  status         String   @default("COMPLETED")
  idempotencyKey String   @map("idempotency_key")
  correlationId  String   @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("transfers")
}

model LedgerEntry {
  entryId      BigInt   @id @default(autoincrement()) @map("entry_id")
  transferId   String   @map("transfer_id")
  accountId    String   @map("account_id")
  direction    String
  amount       String
  balanceAfter String   @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([accountId, entryId(sort: Desc)])
  @@map("ledger_entries")
}

// LEARN (OUTBOX): esta tabla se escribe EN LA MISMA TX que el ledger.
// El relay la lee y publica a Redpanda. Si el relay muere, el evento sigue
// con dispatchedAt = NULL y se reintenta.
model Outbox {
  eventId      String    @id @default(uuid()) @map("event_id")
  aggregate    String
  aggregateId  String    @map("aggregate_id")
  topic        String
  payload      Json
  headers      Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  dispatchedAt DateTime? @map("dispatched_at")

  @@index([dispatchedAt, createdAt])
  @@map("outbox")
}

model IdempotencyKey {
  key          String    @id
  accountId    String    @map("account_id")
  requestHash  String    @map("request_hash")
  status       String    @default("IN_PROGRESS")
  responseCode Int?
  responseBody Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  @@map("idempotency_keys")
}
