# Copiar a .env (el compose ya inyecta estos valores en Docker)
# Puertos host ajustados: 5432/5433/5434 y 6379/6380 ocupados por otros proyectos locales.
DATABASE_URL="postgresql://billetera:billetera@localhost:5544/billetera"
REDPANDA_BROKERS="localhost:19092"
MONGO_URL="mongodb://localhost:27017/billetera"
REDIS_URL="redis://localhost:6381"
JWT_SECRET="dev-secret-cambia-en-prod"
# Para V0 (front separado): NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
